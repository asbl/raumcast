{
  "name": "raumcast",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Raumauswahl und Bildschirmübertragung an AirServer mit Chromium",
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "package": "npm run build && node scripts/package.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "demo": "tsx src/main.ts --demo",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:ui": "tsx scripts/ui-smoke.ts --demo",
    "install:desktop": "tsx scripts/install-desktop.ts",
    "test:audio": "tsx scripts/audio-smoke.ts",
    "test:audit": "tsx scripts/audit-complete-repro.ts --browser"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "castv2-client": "^1.2.0",
    "puppeteer-core": "^25.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "config": {
    "nodeRuntime": "24.22.2"
  },
  "overrides": {
    "protobufjs": "^8.8.1"
  }
}
